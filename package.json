{
  "name": "dsh-yu-weibo",
  "version": "2.1.0",
  "description": "DSH 刷微博插件（只读）：谷时读网页版 m.weibo.cn 的公开内容，接入人格蒸馏；不登录、不点赞评论转发发博。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Speraymer/dsh-yu-weibo.git"
  },
  "homepage": "https://github.com/Speraymer/dsh-yu-weibo#readme",
  "bugs": {
    "url": "https://github.com/Speraymer/dsh-yu-weibo/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "dependencies": {
    "@weibo-ai/weibo-cli": "0.9.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
